# ==========================================
# KalaSetu — Environment Configuration
# ==========================================

# --- 1. SUPABASE CREDENTIALS (Optional) ---
# If left empty, the website runs in Local Demo Mode automatically.
# Get these from your Supabase Project Settings -> API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- 2. CLOUDINARY CREDENTIALS (Optional) ---
# If you want to use Cloudinary for media/image/video hosting.
# In Cloudinary: Settings -> Upload -> Upload presets (Set to 'Unsigned').
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- 3. DEMO PHONE & WHATSAPP (Optional) ---
# Set your own phone/WhatsApp number for live professor testing.
# WhatsApp format: Country code without + (e.g. 919876543210)
VITE_DEMO_WHATSAPP_NUMBER=919876543210
VITE_DEMO_PHONE_NUMBER=+91 98765 43210

# --- 4. COLLEGE & PROJECT CREDITS (Optional) ---
VITE_COLLEGE_NAME=Design Thinking & Innovation Project
VITE_TEAM_MEMBERS=
